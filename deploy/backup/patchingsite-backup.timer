# /etc/systemd/system/patchingsite-backup.timer

[Unit]
Description=Nightly PatchingSite database snapshot

[Timer]
# 03:30 UTC, the site's quietest hour. Persistent catches up
# after a reboot that spanned the scheduled time.
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
