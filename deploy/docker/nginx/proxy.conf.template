# Proxy settings for the FastAPI backend. Rendered by web-entrypoint into
# /etc/nginx/snippets/androidmod-proxy.conf and included by every /api location,
# so a rate-limited location cannot drift from the main one. The app container
# shares the host network and listens on loopback only.

proxy_pass http://127.0.0.1:${APP_PORT};
proxy_http_version 1.1;

proxy_set_header Host              $host;
# The rate limiter keys on X-Real-IP (set here to the real peer, which
# proxy_set_header OVERWRITES so a client cannot forge it), falling back to
# the RIGHTMOST X-Forwarded-For hop. Keep X-Real-IP set, or the limiter is
# left trusting a header the client can prepend to. uvicorn also runs with
# --forwarded-allow-ips=127.0.0.1 so only this proxy is trusted.
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
# Always https: the API is proxied only from the HTTPS server, or, with
# TLS_MODE=external, from the plain-HTTP loopback server the host's nginx
# forwards HTTPS visitors to, where $scheme would say http.
proxy_set_header X-Forwarded-Proto https;

# Signed APKs are 40-155MB. Stream them straight through instead of
# spooling to nginx's temp dir first.
proxy_buffering off;
proxy_max_temp_file_size 0;

# Enqueue and poll return immediately; this covers the file transfer
# itself on a slow connection.
proxy_read_timeout 600s;
proxy_send_timeout 600s;
