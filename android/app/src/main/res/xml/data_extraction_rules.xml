<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing this app stores leaves the device, by cloud backup OR by
    device-to-device transfer. allowBackup="false" alone is not enough there: from
    Android 12, an app targeting 31+ is still copied during a device transfer
    unless these rules exclude it.

    What would travel is the reason. The "auth" prefs hold the bearer token, and
    they are encrypted under an Android keystore key that never leaves this
    device - so on the new phone the file arrives but cannot be decrypted, which is
    exactly the state TokenStore has to recover from. The rest is per-device
    anyway: settings, a subscription display cache, and downloaded builds that
    StoreApp prunes at the next launch.

    Every domain is listed, credential-encrypted and device-protected storage both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
