<?xml version="1.0" encoding="utf-8"?>
<!-- minSdk is 30, so every device here supports adaptive icons and this is the only
     launcher-icon variant the app needs. `monochrome` is what lets Android 13+
     themed icons tint the mark to the user's wallpaper palette. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
