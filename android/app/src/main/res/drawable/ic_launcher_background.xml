<?xml version="1.0" encoding="utf-8"?>
<!-- The site's pap-gradient (120deg, #007aa4 -> #1791fc) across the adaptive
     icon's full 108dp canvas. The canvas is deliberately filled edge to edge:
     the launcher masks it to whatever shape the device uses. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="94" android:endY="62"
                android:startColor="#FF007AA4"
                android:endColor="#FF1791FC" />
        </aapt:attr>
    </path>
</vector>
