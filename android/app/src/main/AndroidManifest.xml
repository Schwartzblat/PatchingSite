<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Without this the system uninstaller starts and exits without drawing its
         dialog, logging only "Uid ... does not have
         android.permission.REQUEST_DELETE_PACKAGES". A normal permission: granted
         at install, no runtime prompt. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Lets the store update itself, and update an app it installed (the app's
         installer of record), without the "Do you want to update this app?" dialog on
         Android 12+. A normal permission that silences nothing by itself: a session must
         also ask for USER_ACTION_NOT_REQUIRED, and SessionInstaller asks only for those
         two cases (silentInstallAllowed), after SignatureVerifier has accepted the build. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The catalogue is server-driven, so the set of packages to inspect is not
         known at build time. This app is self-distributed, never shipped through
         Play, so the broad permission is available to it.
         QueryAllPackagesPermission is suppressed for that reason: it enforces Play's
         policy, which does not apply here. The narrower alternative, a <queries>
         for MAIN/LAUNCHER intents, would hide any catalogue app without a launcher
         icon, and was turned down in favour of keeping this. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- No backups and no device-to-device transfer; res/xml/data_extraction_rules.xml
         says why. allowBackup="false" stays for the platform versions that read it,
         but from Android 12 it no longer stops a device transfer, which is what
         dataExtractionRules is for. targetApi because that attribute is 31+ and
         minSdk is 30; Android 11 reads fullBackupContent instead.
         largeHeap: an on-device WhatsApp build used up to about 221 MB of Java heap on a
         Pixel 9a, whose default limit per app is 256 MB, so a phone with a lower default
         would fail it with an OutOfMemoryError. largeHeap raises the limit to the phone's
         dalvik.vm.heapsize (512 MB on that Pixel). -->
    <application
        android:name=".StoreApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PatchedStore"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- What a patched app opens instead of its own updater. Exported on purpose: it
             validates the package extra, shows nothing and forwards to MainActivity. -->
        <activity
            android:name=".patch.UpdateAppActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.PatchedStore.NoDisplay">
            <intent-filter>
                <action android:name="site.androidmod.store.action.UPDATE_APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".patch.PatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".install.InstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="site.androidmod.store.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Answers whether an app keeps files in Android/obb, right before its original is
             removed. A process of its own that ends after each answer: the store's process keeps
             the storage view it started with, and can't see other apps' Android/obb when
             "Install unknown apps" was allowed after that (see ObbProbeClient). Not exported:
             only the store asks. -->
        <provider
            android:name=".install.ObbProbeProvider"
            android:authorities="${applicationId}.obbprobe"
            android:exported="false"
            android:process=":obbprobe" />

        <!-- Not exported: MY_PACKAGE_REPLACED comes from the system, which delivers
             to unexported receivers, and no other app has any business sending it. -->
        <receiver
            android:name=".update.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
