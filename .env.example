# Copy to .env and fill in. `server/config.py` loads this at import and fails
# fast if any of the three required values are missing.

# --- required ---
JWT_SECRET_KEY=            # openssl rand -hex 32
STRIPE_API_KEY=            # sk_live_... / sk_test_...
STRIPE_PRODUCT_ID=         # prod_...

# --- optional: signing key for tokens embedded in patched APKs ---
# Deliberately a DIFFERENT key from JWT_SECRET_KEY: app tokens ship inside every
# APK we hand out, so they must not be usable as browser session cookies.
# Derived from JWT_SECRET_KEY when unset. Pin it before JWT_SECRET_KEY is ever
# rotated, or every APK already handed out stops working (manage.py doctor warns;
# production was pinned by deploy/launch-setup.sh).
# APP_JWT_SECRET_KEY=

# --- environment ---
# Defaults to "production" when unset, deliberately: this flag decides whether
# session cookies carry the Secure flag and whether X-Forwarded-For is trusted,
# and an unset variable on the live host must not quietly downgrade either.
# Set it to "development" on a dev box, or cookies will be HTTPS-only and
# login over http://localhost will not work.
ENVIRONMENT=development
LOG_LEVEL=DEBUG            # defaults to INFO when ENVIRONMENT=production
# LOG_PATH=/opt/server_data/app.log

# --- optional: paths ---
# PATCHED_APPS_PATH=/opt/patched
# STORE_APK_PATH=/opt/patched/store.apk   # the Android store app the site offers; defaults to <PATCHED_APPS_PATH>/store.apk
# SERVER_DATA_DIR=/opt/server_data

# --- optional: web ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://www.androidmod.site,https://androidmod.site

# --- optional: policy ---
# SESSION_TOKEN_TTL_MINUTES=180
# APP_TOKEN_TTL_DAYS=400
# MAX_DEVICES_ALLOWED=3
# DEVICE_RESET_INTERVAL_DAYS=30       # how often users may clear their own device slots
# DOWNLOAD_MAX_JOBS_PER_USER=2        # queued + running downloads per account
# Once this UTC date has passed, pre-expiry app tokens (old APKs) get a 401 and
# those apps close. Unset keeps accepting them. A malformed value stops startup.
# LEGACY_APP_TOKEN_CUTOFF=2027-01-01

# --- optional: email (password reset links, bug reports) ---
# Without the two credentials the site still works: forgot-password answers 503
# with SUPPORT_EMAIL and bug reports are stored but not mailed. For Gmail, use an
# app password (myaccount.google.com/apppasswords), never the account password.
# SMTP_USERNAME=                     # the Gmail account that sends; need not be SUPPORT_EMAIL
# SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465                       # 465 = implicit TLS; other ports use STARTTLS
# MAIL_FROM=                          # defaults to SMTP_USERNAME
# SUPPORT_EMAIL=sudorm.ext@gmail.com

# --- optional: download job queue ---
# DOWNLOAD_WORKERS=2                  # concurrent APK signings; each is CPU+IO heavy
# DOWNLOAD_JOB_TTL_SECONDS=3600
# DOWNLOAD_URL_TTL_SECONDS=600
# DOWNLOAD_CACHE_MAX_BYTES=21474836480
# SIGNING_TIMEOUT_SECONDS=1200

# --- APK signing keystore (Stitch's fastsigner AND the Android build) ---
# ONE keystore signs both the store app and every artifact the server hands out,
# and they have to match: SignatureVerifier refuses to install a build whose
# signer differs from the store app's own, so a mismatch breaks every download
# rather than merely weakening something.
#
# android/app/build.gradle.kts reads these same four names with the same
# precedence this file is loaded with (process environment > .dev_env > .env), so
# setting them here configures both halves at once. Note that a systemd unit does
# NOT inherit your shell exports - on the live host they must be in this file.
#
# KEY_PASSWORD defaults to KEYSTORE_PASSWORD when omitted, as fastsigner
# does. Omit all four and Stitch falls back to its bundled debug key
# while the Android release build refuses to run at all.
# Use an absolute KEYSTORE_PATH: the server resolves a relative one against
# server/, the Android build against the repo root.
# KEYSTORE_PATH=
# KEY_ALIAS=
# KEYSTORE_PASSWORD=
# KEY_PASSWORD=

# --- on-device patching (all optional; an endpoint whose setting is missing answers 503) ---
# CRAWLER_SECRET=              # token for POST /api/internal/records
# BUNDLE_UPLOAD_SECRET=        # token for POST /api/internal/bundles
# SIGNING_KEYS_MASTER_KEY=     # base64 of 32 random bytes; back it up apart from the database.
#                              # python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# BUNDLE_PUBLIC_KEY_PATH=      # default DATA_DIR/bundle-signing.pub.pem
# BUNDLES_DIR=                 # default DATA_DIR/bundles
# ON_DEVICE_PACKAGES=          # comma-separated packages; set only after a bundle is uploaded
# GENERIC_PATCHING=            # 1/true/yes/on enables the generic ad remover; off when unset
