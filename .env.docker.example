# The env file for running the site with Docker (docker-compose.yml).
#
#   cp .env.docker.example .env
#   chmod 600 .env
#
# One file, two readers. Compose reads it for Section 1 (and FRONTEND_URL and
# CORS_ORIGINS). The server reads all of it itself (mounted read-only at
# /app/.env), with python-dotenv, as it did on the old host.
#
# Moving from the old host: fill in Section 1, then paste the old host's .env
# into Section 2 as it is. Its data, patched, log and keystore paths are
# ignored: compose sets the container paths (the list at the top of Section 2).
# Any other path in it, such as BUNDLES_DIR, must be a path inside the container.
#
# These MUST be the old host's, never new ones:
#   JWT_SECRET_KEY, APP_JWT_SECRET_KEY  new ones log every user out and stop
#                                       every APK already handed out
#   SIGNING_KEYS_MASTER_KEY             a new one makes every stored signing key
#                                       unreadable
#   the keystore (HOST_KEYSTORE_FILE)   a new one makes phones refuse every
#                                       download: it must match the store app
#
# Two traps when editing, for both readers:
# - Never put a comment after an empty value: `KEY=   # note` sets KEY to
#   "# note". Comments go on their own lines.
# - A `$` in a value makes compose warn about an unset variable, though the
#   server gets the value unchanged. Single-quote the value to silence it.

# =============================================================================
# Section 1: Deployment (read by compose)
# =============================================================================

# REQUIRED. The site's bare host name, no scheme: certificates, nginx, links.
DOMAIN=
# letsencrypt (real certificates) | selfsigned (a test, or a VM before DNS moves
# that has no copy of the old host's certificates: README, Docker step 6).
TLS_MODE=letsencrypt
# REQUIRED with TLS_MODE=letsencrypt. Let's Encrypt's expiry notices go here.
LETSENCRYPT_EMAIL=
# 1 uses Let's Encrypt's staging CA (untrusted certificates) to test issuance.
LETSENCRYPT_STAGING=0
# 1 also certifies www.$DOMAIN and redirects it to $DOMAIN; needs a DNS record for www.
WWW_REDIRECT=1

# Host ports. HTTP serves only the ACME challenge and redirects to HTTPS.
HTTP_PORT=80
HTTPS_PORT=443
# The API's port on 127.0.0.1 (loopback only, never exposed).
APP_PORT=8000

# Host paths, mounted into the containers. Each must exist before `up`:
# compose refuses a missing one rather than create it.
# users.db, app.log, download_cache/, bundles/. Mode 700, owned by APP_UID.
HOST_DATA_DIR=/opt/server_data
# Patched builds and store.apk; mounted read-only. APP_UID must be able to read it.
HOST_PATCHED_DIR=/opt/patched
# Nightly snapshots of users.db (mode 600). Mode 700, owned by APP_UID.
HOST_BACKUP_DIR=/var/lib/patchingsite-backups
# REQUIRED. The signing keystore on the host (mode 600, owned by APP_UID); mounted read-only.
HOST_KEYSTORE_FILE=

# The user the app and backup containers run as: the owner of the dirs above.
APP_UID=1000
APP_GID=1000
# Nightly snapshots to keep.
BACKUP_KEEP=14

# The commit the website reports. deploy.sh passes it on each deploy; leave it unset here.
# APP_COMMIT=unknown

# =============================================================================
# Section 2: Server (read by the server; paste the old host's .env here)
# =============================================================================

# Set by compose, ignored here (the container paths and production mode):
#   ENVIRONMENT=production
#   SERVER_DATA_DIR=/opt/server_data
#   DB_PATH=/opt/server_data/users.db
#   LOG_PATH=/opt/server_data/app.log
#   PATCHED_APPS_PATH=/opt/patched
#   STORE_APK_PATH=/opt/patched/store.apk
#   KEYSTORE_PATH=/run/keystore.jks (the file HOST_KEYSTORE_FILE names)

# --- required ---
# The old host's. Only a brand-new site makes one: openssl rand -hex 32
JWT_SECRET_KEY=
# sk_live_... (doctor refuses test keys in production)
STRIPE_API_KEY=
# prod_...
STRIPE_PRODUCT_ID=

# --- signing key for tokens embedded in patched APKs ---
# A different key from JWT_SECRET_KEY: app tokens ship inside every APK, so
# they must not be usable as session cookies. Derived from JWT_SECRET_KEY when
# unset; the old host pinned it (deploy/launch-setup.sh), so copy it over.
# APP_JWT_SECRET_KEY=

# --- logging ---
# LOG_LEVEL=INFO                      # the default in production

# --- web ---
# Compose reads these two as well. Unset, FRONTEND_URL is https://DOMAIN and
# CORS_ORIGINS is https://DOMAIN,https://www.DOMAIN; set them only to override.
# FRONTEND_URL=
# CORS_ORIGINS=

# --- admin panel ---
# Comma-separated accounts that may use /admin. Unset turns the panel off.
# ADMIN_USERNAMES=

# --- policy ---
# SESSION_TOKEN_TTL_MINUTES=180
# APP_TOKEN_TTL_DAYS=400
# MAX_DEVICES_ALLOWED=3
# DEVICE_RESET_INTERVAL_DAYS=30       # how often users may clear their own device slots
# DOWNLOAD_MAX_JOBS_PER_USER=2        # queued + running downloads per account
# Once this UTC date has passed, pre-expiry app tokens (old APKs) get a 401 and
# those apps close. Unset keeps accepting them. A malformed value stops startup.
# LEGACY_APP_TOKEN_CUTOFF=2027-01-01

# --- email (email verification, password reset links, bug reports) ---
# Production needs both credentials: without them new accounts cannot verify
# their email (so cannot subscribe), forgot-password answers 503 and bug
# reports are stored but not mailed. For Gmail, an app password
# (myaccount.google.com/apppasswords), never the account password.
# SMTP_USERNAME is the Gmail account that sends; it need not be SUPPORT_EMAIL.
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465                       # 465 = implicit TLS; other ports use STARTTLS
# MAIL_FROM defaults to SMTP_USERNAME.
# MAIL_FROM=
# SUPPORT_EMAIL=sudorm.ext@gmail.com

# --- download job queue ---
# DOWNLOAD_WORKERS=2                  # concurrent APK signings; each is CPU+IO heavy
# DOWNLOAD_JOB_TTL_SECONDS=3600
# DOWNLOAD_URL_TTL_SECONDS=600
# DOWNLOAD_CACHE_MAX_BYTES=21474836480
# SIGNING_TIMEOUT_SECONDS=1200        # docker-compose.yml's stop_grace_period (22m) allows for this

# --- APK signing keystore ---
# The file itself is HOST_KEYSTORE_FILE in Section 1. It signs every download,
# and must be the keystore the store app was built with: the store app refuses
# to install a build whose signer differs from its own.
# KEY_PASSWORD defaults to KEYSTORE_PASSWORD when omitted.
KEY_ALIAS=
KEYSTORE_PASSWORD=
# KEY_PASSWORD=

# --- on-device patching (all optional; an endpoint whose setting is missing answers 503) ---
# Token for POST /api/internal/records (the crawler).
# CRAWLER_SECRET=
# Token for POST /api/internal/bundles.
# BUNDLE_UPLOAD_SECRET=
# Base64 of 32 bytes: the old host's, see the top of this file. Back it up apart
# from the database. A brand-new site only:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# SIGNING_KEYS_MASTER_KEY=
# Both default under the data dir. A path here is a path INSIDE the container,
# so leave them unset unless it is under /opt/server_data.
# BUNDLE_PUBLIC_KEY_PATH=/opt/server_data/bundle-signing.pub.pem
# BUNDLES_DIR=/opt/server_data/bundles
# Comma-separated packages. Set only after their bundle is uploaded.
# ON_DEVICE_PACKAGES=
# 1/true/yes/on enables the generic ad remover. Off when unset.
# GENERIC_PATCHING=
